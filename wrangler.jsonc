{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmreels-studio",
  "account_id": "451f9ee966232598ed8eeadb97f8d074",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/r2/json/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mm-subtitle-db",
      "database_id": "3f18ace5-1464-41f2-9584-7632964e9c95"
    }
  ],
  "vars": {
    "STUDIO_VERSION": "5.0.0",
    "PUBLIC_APP_TITLE": "Reels 工作室 · 缅甸语五库全链路云端协同中心"
  }
}
